# MariaDB / MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=spacehub
MYSQL_PASSWORD=spacehub
MYSQL_DATABASE=spacehub

# API server
PORT=4000
# Set to "production" on the server so the API also serves the built frontend.
NODE_ENV=development
# Public origin (https://your-domain) used to build absolute links for message
# attachments/buttons sent to Telegram/Viber/Viber Routee. Falls back to the
# incoming request's own origin when unset.
PUBLIC_URL=

# Auth — CHANGE THIS in production to a long random string.
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRES_IN=7d

# Web Push (mobile/desktop push notifications). Generate once with:
#   npx web-push generate-vapid-keys
# Push is silently disabled until both keys are set.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@softify.gr

# Seed configuration
SEED_CUSTOMERS=350000
SEED_CUSTOMERS_T2=800
SEED_PASSWORD=password123
