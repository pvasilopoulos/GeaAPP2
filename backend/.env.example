# MariaDB / MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=spacehub
MYSQL_PASSWORD=spacehub
MYSQL_DATABASE=spacehub

# API server
PORT=4000
# Set to "production" on the server so the API also serves the built frontend.
NODE_ENV=development

# Seed configuration
SEED_CUSTOMERS=350000
